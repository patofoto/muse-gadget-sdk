# LilyGO T-Display-S3 (no touch): ESP32-S3R8 (8 MB octal PSRAM), 16 MB quad
# flash (Winbond W25Q128), the chip's own USB Serial/JTAG on the USB-C port, a
# 170x320 ST7789 on an 8-bit I80 bus, two buttons, no audio. Load last, after
# sdkconfig.muse, which already picks 16 MB flash and partitions_muse.csv.
# Source: LilyGO's T-Display-S3 repo (pin_config.h, schematic/T_Display_S3.pdf).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_LILYGO_T_DISPLAY_S3=y

# Octal PSRAM, set up as on the StickS3 (same R8 part).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# As on the StickS3: static buffers in PSRAM, or BLE setup can't find 8 KB of
# internal RAM for its task.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# Two-button menu.
CONFIG_LV_FONT_MONTSERRAT_12=y

# Screen off on battery: light sleep between button presses, as on the StickS3
# (see sdkconfig.muse-m5stack-sticks3). No 32 kHz crystal: GPIO15 and GPIO16,
# where it would go, are the LCD power switch and the touch interrupt.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP is not set
# CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND is not set
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_PM_PROFILING=y
